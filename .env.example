# Create .env.local from this file and keep the real key only on your computer.
MIMO_API_KEY=

# Pay-as-you-go API. Token Plan users should replace this with their regional
# endpoint, for example https://token-plan-cn.xiaomimimo.com/v1
MIMO_API_BASE_URL=https://api.xiaomimimo.com/v1

# Model used by the local Chinese-to-English translation helper.
MIMO_MODEL=mimo-v2.5
